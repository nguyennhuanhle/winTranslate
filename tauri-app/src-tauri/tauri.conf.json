{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winTranslate",
  "version": "2.1.0",
  "identifier": "com.wintranslate.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "winTranslate",
        "width": 420,
        "height": 120,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "winTranslate — Settings",
        "url": "settings.html",
        "width": 500,
        "height": 480,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src https://translate.googleapis.com https://translate.google.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBNEU3M0IzNUM1OUUyMEQKUldRTjRsbGNzM05PbXJ3MHJBYkJZTlFqaWgxNGx2cEFUVndaeUJqcWxpNytBN2w4aUQ2N0lVUFoK",
      "endpoints": [
        "https://github.com/nguyennhuanhle/winTranslate/releases/latest/download/latest.json"
      ]
    }
  }
}